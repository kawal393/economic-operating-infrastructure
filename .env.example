# SOVEREIGN ENVIRONMENT CONTRACT — sovereign-ai.services
#
# This file is the complete list of secrets and settings the platform reads.
# It exists because the estate used to depend on an editor vendor's environment
# store: values lived in a dashboard we do not control, so a rebuild could not
# be reproduced and a vendor outage could take the signing key with it. From the
# 16 Sep 2026 decoupling, every value below is held by us, on our own host, in a
# file that is never committed.
#
# Copy to `.env` (gitignored) for local builds, and to `/root/sovereign-ai/.env`
# on the VPS (chmod 600) for production.
#
# ---------------------------------------------------------------------------
# 1. CLIENT-VISIBLE — inlined into the browser bundle at BUILD time (VITE_*)
# ---------------------------------------------------------------------------
# The publishable key is public by design: it ships to every visitor and is
# rate-limited and row-level-secured by Supabase. It is not a secret.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Optional. If set, browser error-boundary reports are POSTed here. Leave unset
# and errors stay in the console — nothing is sent to any third party.
# VITE_ERROR_ENDPOINT="https://sovereign-ai.services/api/internal/errors"

# ---------------------------------------------------------------------------
# 2. SERVER-ONLY — read at RUNTIME by the Node process. Never prefix with VITE_.
#    A VITE_ copy of a service-role key would publish it to the whole internet.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Bypasses row-level security. REQUIRED by the registry, ledger and transparency
# reads. If it is absent those endpoints return 500 while the marketing pages
# still render — which is exactly the half-alive failure mode the estate has
# already lived through.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# THE SEAL OF STATE. nation-key.server.ts derives the platform signing key as
#   sha256("sovereign-ai.services/seal-of-state/v1:" + NATION_SIGNING_SEED)
# and publishes the public half at /api/public/v1/jwks.json and
# /.well-known/did.json. EVERY signed checkpoint, receipt signature and DID this
# platform has ever issued was made with the seed currently held in the vendor
# dashboard.
#
# MIGRATION RULE — read before touching this value:
#   * Copy the EXISTING seed from the vendor environment first. Same seed = same
#     public key = same kid = every signature already published still verifies.
#   * Never invent a new seed on the same kid. If the seed must change, publish
#     BOTH keys in the JWKS and record the rotation as a dated amendment, or
#     every counterparty holding an old checkpoint is left unable to verify.
#   * One seed in one environment is the known Article V conformance wound
#     (EMPIRE_STATE.md §30(f)). It is printed as a FAILED check on /charter,
#     not hidden. Federation of this key is the fix and it is not built yet.
NATION_SIGNING_SEED=""

# ---------------------------------------------------------------------------
# 3. OPTIONAL FEATURES
# ---------------------------------------------------------------------------
# Minister voice on /minister and /steward. Without it the component degrades.
ELEVENLABS_API_KEY=""

# ---------------------------------------------------------------------------
# 4. RUNTIME (set by systemd, not by .env)
# ---------------------------------------------------------------------------
# NITRO_HOST=127.0.0.1     bind to loopback only; Caddy terminates TLS in front
# NITRO_PORT=3100
# NODE_OPTIONS=--max-old-space-size=384   (1 GB VPS: leave headroom for Caddy)
