# sovereign-ai.services — environment contract
#
# The complete list of configuration values the platform reads. Copy to `.env`
# (gitignored) for local builds, and place the production copy on the server in
# a file readable only by the service user. No real value is ever committed.
#
# ---------------------------------------------------------------------------
# 1. CLIENT-VISIBLE — inlined into the browser bundle at BUILD time (VITE_*)
# ---------------------------------------------------------------------------
# The publishable key is public by design: it ships to every visitor and is
# rate-limited and row-level-secured by Supabase. It is not a secret.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Optional. If set, browser error-boundary reports are POSTed here. Leave unset
# and errors stay in the console — nothing is sent to any third party.
# VITE_ERROR_ENDPOINT="https://sovereign-ai.services/api/internal/errors"

# ---------------------------------------------------------------------------
# 2. SERVER-ONLY — read at RUNTIME by the Node process. Never prefix with VITE_.
#    A VITE_ copy of a service-role key would publish it to the whole internet.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Bypasses row-level security. REQUIRED by the registry, ledger and transparency
# reads; if it is absent those endpoints fail while the public pages still
# render. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Seed for the platform signing key (derivation is in nation-key.server.ts; the
# public half is published at /api/public/v1/jwks.json and /.well-known/did.json).
# Every signature this platform has ever published verifies against the current
# seed. Never change it casually: a rotation must publish BOTH keys in the JWKS
# and be recorded as a dated amendment, or old checkpoints stop verifying.
NATION_SIGNING_SEED=""

# ---------------------------------------------------------------------------
# 3. OPTIONAL FEATURES
# ---------------------------------------------------------------------------
# Voice on /minister and /steward. Without it the component degrades gracefully.
ELEVENLABS_API_KEY=""

# ---------------------------------------------------------------------------
# 4. RUNTIME (set by the service manager, not by .env)
# ---------------------------------------------------------------------------
# NITRO_HOST=127.0.0.1     bind to loopback only; the TLS terminator sits in front
# NITRO_PORT=3100
# NODE_OPTIONS=--max-old-space-size=384   leave headroom on small hosts
